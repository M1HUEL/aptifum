NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=aptifum
DB_PASSWORD=change_me
DB_NAME=aptifum
DB_NAME_TEST=aptifum_test

JWT_ACCESS_SECRET=generate_a_random_secret
JWT_REFRESH_SECRET=generate_another_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth sessions
MAX_ACTIVE_SESSIONS_PER_USER=5
SESSION_RETENTION_DAYS=30
PASSWORD_RESET_TTL=15m
INVITE_TTL=72h

# Public URL used to build password-reset and invite links
APP_URL=http://localhost:5173

# SMTP (works with Mailtrap: sandbox.smtp.mailtrap.io:2525 for testing, live.smtp.mailtrap.io:587 for production)
# Leave SMTP_HOST empty to fall back to demo mode (tokens returned in the API response)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@aptifum.dev
SMTP_FROM_NAME=Aptifum
