# Copy this file to .env and generate real secrets:
#   Copy-Item .env.production.example .env
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"   (twice)

NODE_ENV=production

# Postgres
DB_USER=aptifum
DB_PASSWORD=change_me_strong_password
DB_NAME=aptifum

# JWT secrets (min 16 chars each) - generate two different values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth sessions
MAX_ACTIVE_SESSIONS_PER_USER=5
SESSION_RETENTION_DAYS=30
PASSWORD_RESET_TTL=15m
INVITE_TTL=72h

# Allowed browser origin for direct API access (the web app is same-origin via nginx)
CORS_ORIGIN=http://localhost:8080

# Host port for the web app (set 80 for a plain http://localhost)
WEB_PORT=8080
