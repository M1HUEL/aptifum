{
  "name": "aptifum",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:seed": "pnpm --filter @aptifum/database seed",
    "db:seed:demo": "pnpm --filter @aptifum/database seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "turbo": "^2.10.8",
    "typescript-eslint": "^8.66.0"
  }
}
