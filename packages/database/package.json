{
  "name": "@aptifum/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts src/migrations/Migration",
    "seed": "ts-node src/seeders/seed.ts",
    "seed:demo": "ts-node src/seeders/seed-demo.ts",
    "seed:demo:transactions": "ts-node src/seeders/seed-demo-transactions.ts"
  },
  "dependencies": {
    "@aptifum/config": "workspace:*",
    "@aptifum/core": "workspace:*",
    "bcryptjs": "^3.0.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
